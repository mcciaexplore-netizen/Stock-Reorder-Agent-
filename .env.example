# Local inventory workspace
BUSINESS_NAME=Your Company
BUSINESS_ADDRESS=
# DATABASE_PATH=data/stocklist.sqlite3
# For Vercel: use a dedicated SQLite Cloud database. Keep the full URL secret.
# SQLITE_CLOUD_URL=sqlitecloud://your-host:8860/stocklist?apikey=your-key
# STOCKLIST_OWNER_USERNAME=owner
# STOCKLIST_OWNER_PASSWORD=use-a-unique-password-at-least-12-characters
# STREAMLIT_SERVER_COOKIE_SECRET=use-a-long-random-secret
# INVENTORY_PATH=inventory.xlsx

# Default to previewing. The web app also requires an explicit live-send choice.
DRY_RUN=true
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Optional command-line explanation; never used to approve or send orders.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional OCR override. Windows built-in OCR is used when this is blank.
# TESSERACT_PATH=C:/Program Files/Tesseract-OCR/tesseract.exe
# Optional unattended maintenance credentials; never commit real values.
# STOCKLIST_USERNAME=
# STOCKLIST_PASSWORD=
